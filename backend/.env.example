# Copy to backend/.env for local development. Never commit real values.
ENVIRONMENT=development
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=sidekick

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of frontend origins allowed by CORS
FRONTEND_URL=http://localhost:3000

# Optional: avatar uploads (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=

# Optional: password reset emails. Without SMTP, development logs the reset link to the console
# and production returns a clear "not configured" error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
