# Base URL of the Sidekick API. "/api/v1" is appended automatically if missing,
# so both https://your-api.onrender.com and https://your-api.onrender.com/api/v1 work.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: custom map tile URL (defaults to OpenStreetMap, no key required)
# NEXT_PUBLIC_MAP_TILE_URL=
